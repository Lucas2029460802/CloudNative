{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": false,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortTailwindcss": {
    "stylesheet": "apps/web/src/index.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".codex/**",
    "docs/*.md",
    "docs/*.pdf",
    "docs/report-assets/**",
    "docs/presentation/slides.md",
    "**/dist/**",
    "docs/presentation/release/**",
    "docs/presentation/dist-single/**",
    "docs/presentation/assets/morph/**",
    "docs/presentation/assets/fonts-subset/**",
    "skills-lock.json",
    "**/bun.lock",
    "**/routeTree.gen.ts",
    "apps/api/drizzle/meta/**"
  ]
}

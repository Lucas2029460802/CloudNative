{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".agents/**",
    "apps/web/src/components/ui/**",
    "scripts/md-to-pdf/**"
  ],
  "ignoreBinaries": ["uv"],
  "ignoreDependencies": [
    "@playwright/cli",
    "@fontsource/noto-sans-sc",
    "@fontsource/source-sans-3",
    "mermaid"
  ],
  "workspaces": {
    "apps/api": {
      "entry": ["src/report.ts"]
    },
    "docs/presentation": {
      "entry": [
        "slides.md",
        "components/**",
        "layouts/**",
        "morph/index.ts",
        "remotion.config.ts",
        "checks/*.ts",
        "morph/render.ts",
        "scripts/*.ts"
      ],
      "ignoreDependencies": [
        "@fontsource/jetbrains-mono",
        "@slidev/theme-default",
        "simple-icons"
      ]
    },
    ".": {
      "entry": ["tests/**/*.ts", "scripts/*.ts"]
    }
  }
}

    "simple-icons": "^16.38.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@remotion/cli": "^4.0.547",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.3",
    "playwright-chromium": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.547",
    "roughjs": "^4.6.6",
    "subset-font": "^2.9.0",

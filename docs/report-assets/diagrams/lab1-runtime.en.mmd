%% English copy of lab1-runtime.mmd for README.en.md. Keep the two in sync.
flowchart TB
  browser(["Browser"]) -->|"HTTP localhost:8080"| port

  subgraph host["Docker host: Compose project venue-booking"]
    port>"Port mapping 0.0.0.0:8080 → container 8080<br/>FRONTEND_PORT, default 8080; the only port published to the host"]

    subgraph fnet["network frontend-net"]
      frontend["frontend<br/>nginx :8080, uid 101<br/>static React build + /api reverse proxy"]
    end

    api["api (on both networks)<br/>Node.js :3000, user node<br/>Hono + oRPC REST API: validation, business rules, migrations"]

    subgraph bnet["network backend-net"]
      database[("database<br/>PostgreSQL 18 :5432, uid 70")]
    end

    volume[("named volume database-data<br/>/var/lib/postgresql")]
  end

  port --> frontend
  frontend -->|"/api/* → api:3000 (HTTP)<br/>via frontend-net"| api
  api -->|"SQL → database:5432<br/>via backend-net"| database
  database -. mounted .- volume

  classDef edge fill:#f1f5f9,stroke:#475569,color:#0f172a
  classDef web fill:#e8f1fd,stroke:#3b7ddd,color:#0f2a4d
  classDef api fill:#e7f6ee,stroke:#2f9e63,color:#0f3a24
  classDef db fill:#fdf3e1,stroke:#d08a1e,color:#4a2f05
  class browser,port edge
  class frontend web
  class api api
  class database,volume db
  style fnet fill:#f5f9ff,stroke:#3b7ddd,stroke-dasharray:5 4
  style bnet fill:#fffaf0,stroke:#d08a1e,stroke-dasharray:5 4

%% English copy of lab2-architecture.mmd for deploy/k8s/README.md. Keep the two in sync.
flowchart TB
  browser(["Browser"]) -->|"minikube service tunnel"| websvc
  apiserver[["kube-apiserver"]]
  logs[("node directory<br/>/var/log/containers")]

  subgraph ns["namespace venue-booking"]
    websvc{{"Service web<br/>NodePort 8080"}} --> web["Deployment web ×2<br/>nginx :8080, static React build"]
    web -->|"/api/* reverse proxy"| apisvc{{"Service api<br/>ClusterIP :3000"}}
    apisvc --> api["Deployment api ×3<br/>Node.js :3000<br/>ServiceAccount api"]
    api -->|SQL| pgsvc{{"Service postgres<br/>Headless :5432"}}
    pgsvc --> pg[("StatefulSet postgres ×1<br/>Pod postgres-0<br/>PVC data-postgres-0<br/>1Gi, standard")]

    cron["CronJob venue-report<br/>*/2 * * * *, Asia/Shanghai<br/>concurrencyPolicy: Forbid"] -->|creates on schedule| cjob["Job<br/>venue-report-&lt;scheduled time, Unix minutes&gt;<br/>node dist/report.js"]
    mjob["Job<br/>venue-report-manual-&lt;id&gt;-&lt;random&gt;<br/>node dist/report.js"]
    cjob -->|SQL| pgsvc
    mjob -->|SQL| pgsvc

    cfg["ConfigMap app-config<br/>Secret postgres-credentials"] -.->|environment| api
    fb["DaemonSet fluent-bit<br/>one Pod per node → stdout"]
  end

  api -->|"HTTPS: create Job (RBAC: report-launcher)"| apiserver -->|manual report| mjob
  logs -->|read-only hostPath| fb

  classDef edge fill:#f1f5f9,stroke:#475569,color:#0f172a
  classDef svc fill:#ffffff,stroke:#64748b,color:#1e293b
  classDef web fill:#e8f1fd,stroke:#3b7ddd,color:#0f2a4d
  classDef api fill:#e7f6ee,stroke:#2f9e63,color:#0f3a24
  classDef db fill:#fdf3e1,stroke:#d08a1e,color:#4a2f05
  classDef job fill:#f1ebfb,stroke:#7b52c7,color:#2a1554
  classDef cfg fill:#f8fafc,stroke:#94a3b8,color:#334155,stroke-dasharray:5 4
  classDef ops fill:#e5f6f7,stroke:#1f9aa5,color:#073b40
  class browser,apiserver edge
  class websvc,apisvc,pgsvc svc
  class web web
  class api api
  class pg,logs db
  class cron,cjob,mjob job
  class cfg cfg
  class fb ops

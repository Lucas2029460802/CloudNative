{
  "name": "venue-booking",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter \"@venue/*\" dev",
    "dev:db": "docker compose -f compose.yaml -f compose.dev.yaml up -d database",
    "build": "bun run --filter \"@venue/*\" build",
    "typecheck": "bun run --filter \"@venue/*\" typecheck && tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun",
    "db:generate": "bun run --filter @venue/api db:generate"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/cli": "^0.1.22",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "knip": "^6.42.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.23.15",
    "basic-ftp": "^6.2.3",
    "lighthouse": "^13.5.0",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1"
  }
}
